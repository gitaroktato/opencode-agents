{
  "$schema": "https://opencode.ai/config.json",
  "model": "unsloth/Qwen3.6-27B-GGUF",
  "autoupdate": "notify",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "mkdir *": "allow",
      "npm *": "allow",
      "rm *": "ask",
      "grep *": "allow",
      "head *": "allow"
    },
    "external_directory": "ask",
  },
  "provider": {
    "unsloth-studio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "unsloth-studio",
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1",
        "apiKey": ""
      },
      "models": {
        "qwen3.6-27b": {
          "name": "unsloth/Qwen3.6-27B-GGUF",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "qwen3.6-32b-a3b": {
          "name": "unsloth/Qwen3.6-35B-A3B-GGUF",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "awslabs.aws-diagram-mcp-server": {
      "type": "local",
      "command": [
        "uvx",
        "awslabs.aws-diagram-mcp-server"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "enabled": true
    },
    "awslabs.aws-documentation-mcp-server": {
      "type": "local",
      "command": [
        "uvx",
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "enabled": true
    },
    "azure-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure/mcp@latest",
        "server",
        "start",
        "--namespace",
        "wellarchitectedframework",
        "--namespace",
        "cloudarchitect"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "enabled": true
    },
    "drawio": {
      "type": "local",
      "command": [
        "npx",
        "@drawio/mcp"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "enabled": true
    },
    "tessera": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "enabled": true,
    },
  },
  "tools": {
    "awslabs*": false,
    "drawio": false,
    "tessera": false
  },
}
